  "imports": {
    "@types/react": "npm:@types/react@^19.3.0",
    "hono": "npm:hono@^4.13.11",
    "ink": "npm:ink@^7.1.1",
    "ink-scroll-view": "npm:ink-scroll-view@^0.4.0",
    "ink-text-input": "npm:ink-text-input@^6.0.0",
    "react": "npm:react@^19.3.0",
    "zod": "npm:zod@^4.6.5"
  }
}
